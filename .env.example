# Copy to .env and fill in:
BOT_TOKEN=your_telegram_bot_token_here

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Bot behaviour
AUTO_PLAN_AFTER=5          # trigger /plan after this many replies
AUTO_PLAN_TIMEOUT=3600     # or after this many seconds (1 h)
DB_PATH=touchgrass.db
